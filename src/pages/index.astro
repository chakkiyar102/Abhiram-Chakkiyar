---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import Avatar from "@/components/Avatar.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const { socials } = config;

const locale = Astro.currentLocale ?? config.site.lang;

// --- Posts ---
const allPosts = await getCollection("posts", ({ data }) => !data.draft);

// Featured: most recent piece of writing
const featuredEssay = getSortedPosts(allPosts)[0] ?? null;

// --- Projects ---
const allProjects = await getCollection("projects", ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});
const featuredProjects = allProjects
  .filter(p => p.data.featured)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 2);

const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <!-- Hero -->
    <section
      id="hero"
      class="border-border border-b pt-4 pb-8 sm:pt-6 sm:pb-10"
    >
      <h1
        class="hero-statement font-display font-semibold tracking-tight"
        style="font-size:clamp(2.75rem,9vw,5.5rem);line-height:1.02;text-wrap:balance"
      >
        I make complex things <span
          class="hero-accent relative whitespace-nowrap text-accent"
          >clear<svg
            class="hero-underline"
            viewBox="0 0 200 16"
            fill="none"
            aria-hidden="true"
            preserveAspectRatio="none"
            ><path
              d="M3 11 C40 4, 80 4, 117 8 C150 11, 180 9, 197 5"
              stroke="currentColor"
              stroke-width="3.5"
              stroke-linecap="round"
            ></path></svg
          ></span
        >.
      </h1>

      <p
        class="hero-sub text-muted-foreground mt-9 max-w-prose text-lg text-pretty sm:mt-11 sm:text-xl"
      >
        Writer and documentation lead. I turn complex software into words people
        actually understand.
      </p>

      <div class="hero-byline mt-9 flex items-center gap-4">
        <Avatar src="/avatar.jpg" alt="Abhiram Chakkiyar" size={52} />
        <div class="min-w-0">
          <p class="font-display leading-tight font-semibold">
            Abhiram Chakkiyar
          </p>
          {socials.length > 0 && (
            <div class="mt-1">
              <Socials />
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- Featured Essay -->
    {
      featuredEssay && (
        <section id="featured-essay" class="border-border border-b pt-10 pb-6">
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="text-2xl font-semibold tracking-tight">
              Featured Writing
            </h2>
            <LinkButton
              href={getRelativeLocaleUrl(locale, "writing")}
              class="text-sm opacity-70 hover:opacity-100 whitespace-nowrap"
            >
              View all
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          </div>
          <ul>
            <Card variant="h3" {...featuredEssay} />
          </ul>
        </section>
      )
    }

    <!-- Project Teasers -->
    {
      featuredProjects.length > 0 && (
        <section id="project-teasers" class="pt-10 pb-6">
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="text-2xl font-semibold tracking-tight">Projects</h2>
            <LinkButton
              href={getRelativeLocaleUrl(locale, "projects")}
              class="text-sm opacity-70 hover:opacity-100 whitespace-nowrap"
            >
              View all
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          </div>
          <ul>
            {featuredProjects.map(project => (
              <ProjectCard project={project} />
            ))}
          </ul>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
