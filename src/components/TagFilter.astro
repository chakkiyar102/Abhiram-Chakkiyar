---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getUniqueTags } from "@/utils/getUniqueTags";
import config from "@/config";
import TagFilterSelect from "@/components/TagFilterSelect";

// Self-contained: builds the tag list itself so pages just drop <TagFilter />.
const posts = await getCollection("posts", ({ data }) => !data.draft);
const tags = getUniqueTags(posts);
const locale = Astro.currentLocale ?? config.site.lang;
const allHref = getRelativeLocaleUrl(locale, "writing");
const options = tags.map(({ tag, tagName }) => ({
  href: getRelativeLocaleUrl(locale, `tags/${tag}`),
  label: tagName,
}));
---

<TagFilterSelect client:load allHref={allHref} options={options} />
