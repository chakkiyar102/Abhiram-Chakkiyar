---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import Datetime from "./Datetime.astro";
import Views from "./Views.astro";


type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, tier, ...props } = data;
const tierLabel = tier === "note" ? "Note" : "Essay";
const postUrl = getPostUrl(id, filePath, Astro.currentLocale);
---

<li class="my-9">
  <a
    href={postUrl}
    class:list={[
      "text-accent inline-block text-lg font-medium",
      "decoration-dashed underline-offset-4 hover:underline",
      "focus-visible:no-underline focus-visible:underline-offset-0",
    ]}
  >
    <Heading transition:name={toTransitionName(title)}>
      <span
        class="border-border text-muted-foreground mr-2 rounded border px-1.5 py-0.5 align-middle text-xs font-medium tracking-wide uppercase"
        >{tierLabel}</span
      >{title}
    </Heading>
  </a>
  <div class="text-muted-foreground mt-2 flex items-center gap-x-2">
    <Datetime {...props} />
    <Views path={postUrl} />
  </div>
  <p class="mt-2.5 leading-relaxed">{description}</p>
</li>
