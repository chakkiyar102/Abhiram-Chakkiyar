---
interface Props {
  src?: string;
  alt: string;
  size?: number;
}

const { src, alt, size = 128 } = Astro.props;
---

{src ? (
  <img
    src={src}
    alt={alt}
    width={size}
    height={size}
    class="rounded-2xl object-cover shadow-md"
  />
) : (
  <div
    class="flex items-center justify-center rounded-2xl shadow-md text-4xl font-semibold text-white"
    style={`width:${size}px;height:${size}px;background:linear-gradient(135deg,#0e8a8a,#5fd0c5)`}
    aria-label={alt}
  >AC</div>
)}
